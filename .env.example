# Core
ENVIRONMENT=development
DATABASE_URL=sqlite:///./jobs.db
ADMIN_API_KEY=replace-with-a-long-random-value
LOG_LEVEL=INFO

# Broad U.S. market feed (recommended)
THEIRSTACK_API_KEY=
THEIRSTACK_BASE_URL=https://api.theirstack.com

# Ingestion
US_ONLY=true
POSTED_WITHIN_HOURS=24
SYNC_INTERVAL_MINUTES=120
SYNC_SCHEDULER_ENABLED=true
SYNC_ON_STARTUP=false
MAX_PAGES_PER_SOURCE=5
PAGE_SIZE=100
HTTP_TIMEOUT_SECONDS=30
SOURCE_CONFIG_PATH=config/sources.yaml

# Search profile / deterministic fit scoring
TARGET_TITLES=Software Engineer,AI Engineer,Machine Learning Engineer,LLM Engineer,Data Engineer,Data Scientist,Python Developer,Backend Engineer,Full Stack Engineer
TARGET_SKILLS=Python,FastAPI,Django,Flask,JavaScript,TypeScript,React,SQL,AWS,Docker,Kubernetes,Machine Learning,LLM,RAG,AI Agents
PREFERRED_LOCATIONS=New York,NYC,New Jersey,NJ,Remote
